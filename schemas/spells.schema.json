{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/spells.schema.json",
  "title": "D&D 3.5e SRD Spell Dataset (compact list + full tooltip text)",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "spells"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatedAt", "sources"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "baseUrl"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "baseUrl": { "type": "string", "format": "uri" },
              "licenseNote": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/spell" }
    }
  },
  "$defs": {
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "school",
        "levels",
        "components",
        "castingTime",
        "range",
        "duration",
        "savingThrow",
        "spellResistance",
        "brief",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[A-Z][a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "srdUrl": { "type": "string", "format": "uri" },

        "school": {
          "type": "string",
          "enum": [
            "Abjuration",
            "Conjuration",
            "Divination",
            "Enchantment",
            "Evocation",
            "Illusion",
            "Necromancy",
            "Transmutation",
            "Universal"
          ]
        },
        "subschool": { "type": "string" },
        "descriptors": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },

        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["byClass"],
          "properties": {
            "byClass": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Bard": { "$ref": "#/$defs/spellLevel" },
                "Cleric": { "$ref": "#/$defs/spellLevel" },
                "Druid": { "$ref": "#/$defs/spellLevel" },
                "Paladin": { "$ref": "#/$defs/spellLevel" },
                "Ranger": { "$ref": "#/$defs/spellLevel" },
                "Sorcerer": { "$ref": "#/$defs/spellLevel" },
                "Wizard": { "$ref": "#/$defs/spellLevel" }
              }
            },
            "byDomain": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/spellLevel" }
            }
          }
        },

        "components": {
          "type": "array",
          "items": { "enum": ["V", "S", "M", "F", "DF", "XP"] },
          "uniqueItems": true
        },
        "componentDetails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "material": { "type": "string" },
            "focus": { "type": "string" },
            "xp": { "type": "string" }
          }
        },

        "castingTime": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "targets": { "type": "string" },
        "area": { "type": "string" },
        "effect": { "type": "string" },
        "duration": { "type": "string", "minLength": 1 },
        "savingThrow": { "type": "string", "minLength": 1 },
        "spellResistance": { "type": "string", "minLength": 1 },

        "brief": { "type": "string", "minLength": 1 },

        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Tooltip-friendly text. Recommended: markdown-ish plain text."
        },

        "briefByList": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },

        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "normalizedName": { "type": "string" },
            "aliases": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "tokens": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "spellLevel": { "type": "integer", "minimum": 0, "maximum": 9 }
  }
}
